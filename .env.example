# Copy to .env and fill in your own values. Never commit .env.

# One OpenRouter key serves every model in data/models.json.
OPENROUTER_API_KEY='your_openrouter_api_key_here'

# MongoDB response storage. URL-encode reserved characters in the credentials.
MONGODB_URI='mongodb://USERNAME:PASSWORD@localhost:27017/?authSource=admin'
MONGODB_DATABASE='interviewdb'
MONGODB_COLLECTION='interview_responses'

# Optional: model id from data/models.json for the agent's own tasks (default model if unset).
# AGENT_MODEL_ID='gemini'

# Optional: API address used by the Streamlit frontend.
# SMART_INTERVIEW_API_URL='http://127.0.0.1:8000'
